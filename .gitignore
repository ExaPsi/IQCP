# ========================================
# IQCP Project - .gitignore
# ========================================

# ========================================
# Operating System Files
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ========================================
# IDE and Editor Files
# ========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ========================================
# Rust / Cargo
# ========================================
/target/
**/target/
**/*.rs.bk
*.pdb

# ========================================
# WebAssembly
# ========================================
pkg/
*.wasm
*.wat

# ========================================
# Node.js / npm / pnpm / yarn
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ========================================
# Build Outputs
# ========================================
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/

# ========================================
# Environment and Configuration
# ========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.local.toml
*.local.json
*.local.yaml
*.local.yml

# Secrets
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# ========================================
# Logs and Databases
# ========================================
logs/
*.log
*.sql
*.sqlite
*.sqlite3
*.db

# ========================================
# Python Virtual Environment
# ========================================
.venv/
venv/
ENV/
env/
*.pyc
*.pyo
*.egg-info/
__pycache__/

# ========================================
# Testing and Coverage
# ========================================
coverage/
.nyc_output/
*.lcov
.coverage
htmlcov/
.tox/
.pytest_cache/

# ========================================
# Documentation Build
# ========================================
_site/
.docusaurus/
.cache-loader/

# ========================================
# Cloudflare Workers
# ========================================
.wrangler/
.dev.vars

# ========================================
# Temporary Files
# ========================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.backup

# ========================================
# Miscellaneous
# ========================================
*.cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vercel
.netlify
