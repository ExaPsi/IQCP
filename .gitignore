# ========================================
# IQCP Project - .gitignore
# ========================================

# ========================================
# Operating System Files
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ========================================
# IDE and Editor Files
# ========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# ========================================
# Rust / Cargo
# ========================================
/target/
**/target/
# NOTE: Cargo.lock is intentionally tracked at the workspace root
# (binary/application project — pinned for reproducibility).
**/*.rs.bk
*.pdb

# ========================================
# WebAssembly
# ========================================
pkg/
*.wasm
*.wat
*.wasm.gz

# ========================================
# Node.js / npm / pnpm / yarn
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ========================================
# Build Outputs
# ========================================
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/
.vite/

# ========================================
# Environment and Configuration
# ========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.local.toml
*.local.json
*.local.yaml
*.local.yml

# Secrets
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# ========================================
# Logs and Databases
# ========================================
logs/
*.log
*.sql
*.sqlite
*.sqlite3
*.db

# ========================================
# Python Virtual Environment
# ========================================
.venv/
venv/
ENV/
env/
*.pyc
*.pyo
*.egg-info/

# ========================================
# Testing and Coverage
# ========================================
coverage/
.nyc_output/
*.lcov
.coverage
htmlcov/
.tox/
.pytest_cache/
__pycache__/
playwright-report/
test-results/

# ========================================
# Documentation Build
# ========================================
_site/
.docusaurus/
.cache-loader/

# ========================================
# Cloudflare Workers
# ========================================
.wrangler/
.dev.vars

# ========================================
# Temporary Files
# ========================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.backup

# ========================================
# Package Lock Files (optional - uncomment if needed)
# ========================================
# package-lock.json
# pnpm-lock.yaml
# yarn.lock

# ========================================
# Reference Libraries (external knowledge bases)
# ========================================
references/

# ========================================
# Manuscripts and Publications (local only)
# ========================================
docs/Manuscripts/

# ========================================
# Benchmark Results (machine-specific)
# ========================================
tests/benchmarks/pyscf/results/*.json
tests/benchmarks/bundle/results/*.json

# ========================================
# Miscellaneous
# ========================================
*.cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.vercel
.netlify


