{
  "name": "iqcp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wasm": "wasm-pack build ../../crates/qc-wasm --release --target web --out-dir ../../apps/web/src/wasm",
    "build:wasm:dev": "wasm-pack build ../../crates/qc-wasm --dev --target web --out-dir ../../apps/web/src/wasm",
    "build:wasm:parallel": "echo 'Requires nightly Rust. Run: rustup run nightly wasm-pack build ../../crates/qc-wasm --release --target web --features parallel --out-dir ../../apps/web/src/wasm -- -Z build-std=panic_abort,std'",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "bash scripts/check-bundle-size.sh",
    "check:all": "npm run typecheck && npm run lint && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/react-plotly.js": "^2.6.4",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.27",
    "lz-string": "^1.5.0",
    "plotly.js-basic-dist": "^3.3.1",
    "plotly.js-cartesian-dist": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.28.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.183.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/katex": "^0.16.8",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vite-plugin-cross-origin-isolation": "^0.1.6",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^4.1.0"
  }
}
